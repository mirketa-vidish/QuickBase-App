<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Client_FirstName_Mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISCHANGED(StageName),
ISPICKVAL(StageName, &quot;Admission Scheduled&quot;),
ISBLANK(   Caller_First_Name__c )
)</errorConditionFormula>
    <errorDisplayField>Caller_First_Name__c</errorDisplayField>
    <errorMessage>Please Provide Caller FirstName</errorMessage>
</ValidationRule>
