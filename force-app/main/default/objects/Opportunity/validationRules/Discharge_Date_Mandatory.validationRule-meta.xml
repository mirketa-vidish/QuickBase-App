<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Discharge_Date_Mandatory</fullName>
    <active>false</active>
    <errorConditionFormula>AND( ISCHANGED(StageName), 
    ISPICKVAL(StageName, &quot;Alumni-Discharged&quot;), 
  ISBLANK( DC_Date__c) 
 )</errorConditionFormula>
    <errorDisplayField>DC_Date__c</errorDisplayField>
    <errorMessage>Please Provide Discharge Date</errorMessage>
</ValidationRule>
