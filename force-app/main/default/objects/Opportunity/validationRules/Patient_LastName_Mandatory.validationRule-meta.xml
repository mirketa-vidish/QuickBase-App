<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Patient_LastName_Mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISCHANGED(StageName),
ISPICKVAL(StageName, &quot;Admission Scheduled&quot;),
ISBLANK( Client_Last_Name__c)
)</errorConditionFormula>
    <errorDisplayField>Client_Last_Name__c</errorDisplayField>
    <errorMessage>Please Provide Patient LastName</errorMessage>
</ValidationRule>
